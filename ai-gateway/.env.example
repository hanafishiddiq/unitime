# ==============================================================================
# UniTime AI Ingestion Gateway Configuration
# ==============================================================================

# --- UniTime Smart Ingest API Target ---
# Base endpoint URL to the SmartIngestConnector in UniTime (Docker default: port 8888)
UNITIME_API_URL=http://localhost:8888/api/smart-ingest

# Authentication credentials for UniTime
UNITIME_USERNAME=admin
UNITIME_PASSWORD=admin
UNITIME_TIMEOUT_SECONDS=60

# --- LLM Provider Settings ---
# Pilihan provider:
# 1. 'gemini'     -> Google Gemini (cukup GEMINI_API_KEY)
# 2. 'openai'     -> OpenAI (cukup OPENAI_API_KEY)
# 3. 'anthropic'  -> Anthropic Claude (cukup ANTHROPIC_API_KEY)
# 4. 'openrouter' / 'custom' / 'ollama' / 'proxy' -> OpenAI-Compatible Custom Endpoints
# 5. 'mock'       -> Mode pengujian offline tanpa kuota API (default)
DEFAULT_LLM_PROVIDER=gemini

# Model Identifiers
GEMINI_MODEL=gemini-1.5-pro-latest
OPENAI_MODEL=gpt-4o
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# API Keys
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Custom Base URL / AI Proxy (Opsional) ---
# Jika menggunakan OpenRouter, Ollama, vLLM, Azure, atau AI Proxy (seperti ai.hanavy.online)
# Cukup isi Base URL di bawah ini:
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_BASE_URL=http://localhost:11434/v1
# OPENAI_BASE_URL=https://ai.hanavy.online/v1
OPENAI_BASE_URL=

# --- Pipeline Settings ---
DEFAULT_VALIDATION_STRICTNESS=strict
LOG_LEVEL=INFO
