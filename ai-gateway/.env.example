# ==============================================================================
# UniTime AI Ingestion Gateway Configuration
# ==============================================================================

# --- UniTime Smart Ingest API Target ---
# Base endpoint URL to the SmartIngestConnector in UniTime
UNITIME_API_URL=http://localhost:8080/unitime/api/smart-ingest

# Authentication: Choose Basic Auth OR Bearer Token
# For Basic Auth (API User / Connector Credentials):
UNITIME_USERNAME=admin
UNITIME_PASSWORD=admin

# For Bearer Token (if configured via reverse proxy / API Gateway):
UNITIME_API_TOKEN=

# Request timeout in seconds
UNITIME_TIMEOUT_SECONDS=60

# --- LLM Provider Settings ---
# Provider choice: 'gemini', 'openai', 'anthropic', or 'mock'
DEFAULT_LLM_PROVIDER=mock

# Model identifiers per provider
GEMINI_MODEL=gemini-1.5-pro-latest
OPENAI_MODEL=gpt-4o
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# API Keys
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Ingestion Strictness: 'strict' or 'lenient'
DEFAULT_VALIDATION_STRICTNESS=strict

# Logging Level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
